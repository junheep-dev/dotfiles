#!/bin/bash

set -u

status_dir="${AGENT_STATUS_DIR:-/tmp/agent-status-$(id -u)}"
tmux_bin="$(command -v tmux 2>/dev/null || true)"
nvim_bin="$(command -v nvim 2>/dev/null || true)"
ancestor_pids=""
agent_pid=""

mkdir -p "$status_dir"
chmod 700 "$status_dir" 2>/dev/null || true

state_path() {
  local source="$1" agent_pid="$2" key
  key=$(printf '%s' "$source:$agent_pid" | shasum -a 256 | awk '{print $1}')
  printf '%s/%s.json' "$status_dir" "$key"
}

json_value() {
  local payload="$1" expression="$2"
  printf '%s' "$payload" | jq -r "$expression // empty" 2>/dev/null
}

tmux_value() {
  local pane="$1" format="$2"
  [ -n "$tmux_bin" ] && [ -n "$pane" ] || return 0
  "$tmux_bin" display-message -t "$pane" -p "$format" 2>/dev/null || true
}

client_details() {
  local agent_session="$1" line fallback=""
  [ -n "$tmux_bin" ] || return 0

  while IFS= read -r line; do
    [ -n "$fallback" ] || fallback="$line"
    if [ "$(printf '%s' "$line" | cut -f3)" = "$agent_session" ]; then
      printf '%s' "$line"
      return
    fi
  done <<EOF
$("$tmux_bin" list-clients -F '#{client_activity}	#{client_name}	#{client_session}	#{client_tty}' 2>/dev/null | sort -rn)
EOF
  printf '%s' "$fallback"
}

refresh_tmux() {
  local client
  [ -n "$tmux_bin" ] || return 0
  publish_status
  "$tmux_bin" list-clients -F '#{client_name}' 2>/dev/null | while IFS= read -r client; do
    [ -n "$client" ] && "$tmux_bin" refresh-client -t "$client" -S 2>/dev/null || true
  done
}

notify_nvim() {
  local path="$1" address="$2" encoded
  [ -n "$nvim_bin" ] && [ -n "$address" ] || return 0
  encoded=$(printf '%s' "$path" | base64 | tr -d '\n')
  "$nvim_bin" --server "$address" --remote-expr \
    "luaeval(\"require('agent_status').update(vim.base64.decode(_A))\", '$encoded')" \
    >/dev/null 2>&1 &
}

# Walks up from the hook process, recording the ancestor chain and picking out
# the agent process itself. State is keyed on that process rather than on the
# session id: one codex process runs several threads of its own (title
# generation, review), and each would otherwise claim its own status badge.
scan_ancestors() {
  local source="$1" pid="$PPID" parent comm depth=0
  ancestor_pids=""
  agent_pid=""
  while [ "$pid" -gt 1 ] 2>/dev/null && [ "$depth" -lt 16 ]; do
    ancestor_pids="${ancestor_pids}${ancestor_pids:+,}${pid}"
    if [ -z "$agent_pid" ]; then
      comm=$(ps -o comm= -p "$pid" 2>/dev/null | sed 's|.*/||')
      [ "$comm" != "$source" ] || agent_pid="$pid"
    fi
    parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    case "$parent" in
      ''|*[!0-9]*) break ;;
    esac
    [ "$parent" != "$pid" ] || break
    pid="$parent"
    depth=$((depth + 1))
  done
  [ -n "$agent_pid" ] || agent_pid="$PPID"
}

is_visible() {
  local path="$1" pane client_name client_session agent_session pane_active window_active frontmost
  [ -n "$tmux_bin" ] || return 1

  pane=$(jq -r '.pane // empty' "$path")
  client_name=$(jq -r '.client_name // empty' "$path")
  agent_session=$(jq -r '.tmux_session // empty' "$path")
  [ -n "$pane" ] && [ -n "$client_name" ] || return 1

  client_session=$("$tmux_bin" display-message -c "$client_name" -p '#{client_session}' 2>/dev/null || true)
  pane_active=$(tmux_value "$pane" '#{pane_active}')
  window_active=$(tmux_value "$pane" '#{window_active}')
  frontmost=$(osascript -e \
    'tell application "System Events" to get name of first application process whose frontmost is true' \
    2>/dev/null | tr '[:upper:]' '[:lower:]')

  [ "$frontmost" = "ghostty" ] \
    && [ "$client_session" = "$agent_session" ] \
    && [ "$pane_active" = "1" ] \
    && [ "$window_active" = "1" ]
}

send_notification() {
  local path="$1" tty location message
  is_visible "$path" && return

  tty=$(jq -r '.client_tty // empty' "$path")
  [ -n "$tty" ] && [ -w "$tty" ] || return
  location=$(jq -r '.location // "Agent"' "$path")
  message=$(jq -r '.message // empty' "$path")
  [ -n "$message" ] || message="Agent needs your attention"
  printf '\033]777;notify;%s;%s\007' "$location" "$message" >"$tty"
}

write_state() {
  local source="$1" agent_pid="$2" session_id="$3" phase="$4" unread="$5" message="$6"
  local path pane tmux_session location nvim client_line client_name client_tty
  local previous_phase previous_unread previous_tmux_unread previous_session_id
  local temp notify_needed=true
  local tmux_unread="$unread"

  path=$(state_path "$source" "$agent_pid")
  pane="${TMUX_PANE:-}"
  nvim="${NVIM:-}"

  if [ -f "$path" ]; then
    [ -n "$pane" ] || pane=$(jq -r '.pane // empty' "$path")
    [ -n "$nvim" ] || nvim=$(jq -r '.nvim // empty' "$path")
    previous_phase=$(jq -r '.phase // empty' "$path")
    previous_unread=$(jq -r '.unread // false' "$path")
    previous_session_id=$(jq -r '.session_id // empty' "$path")
    # An agent process runs threads of its own alongside the conversation, and
    # theirs are short. Letting one report "done" over a turn that is still
    # going would hand the bar a finished badge for work still in flight.
    if [ "$previous_session_id" != "$session_id" ]; then
      case "$previous_phase" in
        running|waiting) return ;;
      esac
    fi
    previous_tmux_unread=$(jq -r 'if has("tmux_unread") then .tmux_unread else (.unread // false) end' "$path")
    if [ "$previous_phase" = "$phase" ] && [ "$previous_unread" = "$unread" ]; then
      notify_needed=false
      tmux_unread="$previous_tmux_unread"
    fi
  fi

  # Neither display can reach an agent outside tmux and outside nvim, so
  # recording one would only leave a file nothing ever shows or clears.
  [ -n "$pane" ] || [ -n "$nvim" ] || return

  tmux_session=$(tmux_value "$pane" '#{session_name}')
  location=$(tmux_value "$pane" '#{session_name}:#{window_index}.#{pane_index} #{window_name}')
  [ -n "$location" ] || location="Agent"

  client_line=$(client_details "$tmux_session")
  client_name=$(printf '%s' "$client_line" | cut -f2)
  client_tty=$(printf '%s' "$client_line" | cut -f4)

  temp=$(mktemp "$status_dir/.state.XXXXXX")
  jq -n \
    --arg source "$source" \
    --arg session_id "$session_id" \
    --argjson agent_pid "$agent_pid" \
    --arg phase "$phase" \
    --argjson unread "$unread" \
    --argjson tmux_unread "$tmux_unread" \
    --arg message "$message" \
    --arg pane "$pane" \
    --arg tmux_session "$tmux_session" \
    --arg location "$location" \
    --arg client_name "$client_name" \
    --arg client_tty "$client_tty" \
    --arg nvim "$nvim" \
    --arg ancestor_pids "$ancestor_pids" \
    '{
      source: $source,
      session_id: $session_id,
      agent_pid: $agent_pid,
      phase: $phase,
      unread: $unread,
      tmux_unread: $tmux_unread,
      message: $message,
      pane: $pane,
      tmux_session: $tmux_session,
      location: $location,
      client_name: $client_name,
      client_tty: $client_tty,
      nvim: $nvim,
      ancestor_pids: ($ancestor_pids | split(",") | map(select(length > 0) | tonumber))
    }' >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$path"

  refresh_tmux
  notify_nvim "$path" "$nvim"
  if [ "$unread" = "true" ] && [ "$notify_needed" = "true" ]; then
    send_notification "$path"
  fi
}

remove_state() {
  local source="$1" agent_pid="$2" path nvim
  path=$(state_path "$source" "$agent_pid")
  [ -f "$path" ] || return
  nvim=$(jq -r '.nvim // empty' "$path")
  rm -f "$path"
  refresh_tmux
  notify_nvim "$path" "$nvim"
}

remove_path() {
  local path="$1"
  [ -f "$path" ] || return
  case "$path" in
    "$status_dir"/*.json) ;;
    *) return ;;
  esac
  rm -f "$path"
  refresh_tmux
}

prune_stale_states() {
  local file pid nvim changed=false

  for file in "$status_dir"/*.json; do
    [ -f "$file" ] || continue
    pid=$(jq -r '.agent_pid // empty' "$file")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    nvim=$(jq -r '.nvim // empty' "$file")
    rm -f "$file"
    notify_nvim "$file" "$nvim"
    changed=true
  done

  [ "$changed" = false ] || refresh_tmux
}

handle_event() {
  local source="$1" payload session_id event_type notification_type message phase unread path
  payload=$(cat)
  session_id=$(json_value "$payload" '.session_id')
  event_type=$(json_value "$payload" '.hook_event_name // .type')
  notification_type=$(json_value "$payload" '.notification_type')
  message=$(json_value "$payload" '.last_assistant_message // .message')
  message=$(printf '%s' "$message" | head -1 | cut -c1-240)

  scan_ancestors "$source"

  case "$event_type" in
    SessionStart)
      prune_stale_states
      remove_state "$source" "$agent_pid"
      printf '{}\n'
      return
      ;;
    UserPromptSubmit)
      phase="running"
      unread=false
      ;;
    PostToolUse|PostToolUseFailure)
      path=$(state_path "$source" "$agent_pid")
      if [ ! -f "$path" ] || [ "$(jq -r '.phase // empty' "$path")" != "waiting" ]; then
        printf '{}\n'
        return
      fi
      phase="running"
      unread=false
      ;;
    Notification)
      case "$notification_type" in
        idle_prompt|agent_completed)
          phase="done"
          unread=true
          [ -n "$message" ] || message="Agent finished"
          ;;
        permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|quota_auto_resume_stale|quota_auto_resume_disabled)
          phase="waiting"
          unread=true
          [ -n "$message" ] || message="Agent needs input"
          ;;
        elicitation_complete|elicitation_response|quota_auto_resume_fired)
          phase="running"
          unread=false
          ;;
        *)
          printf '{}\n'
          return
          ;;
      esac
      ;;
    Stop)
      phase="done"
      unread=true
      [ -n "$message" ] || message="Agent finished"
      ;;
    SessionEnd)
      remove_state "$source" "$agent_pid"
      printf '{}\n'
      return
      ;;
    *)
      printf '{}\n'
      return
      ;;
  esac

  write_state "$source" "$agent_pid" "$session_id" "$phase" "$unread" "$message"
  printf '{}\n'
}

# Recomputes every badge in one pass and stores it on the matching tmux object.
# Drawing the status line then costs nothing but a format lookup, and the
# renderer no longer has to reach into the state directory to draw a bar.
#
# One `list-panes -a` describes the whole tree: every window holds a pane and
# every session holds a window, so panes, windows and sessions are all derived
# from it. Sessions also get the badge summary of the *other* sessions, since
# the bar can only switch sessions and per-window entries would imply a jump it
# cannot offer.
publish_status() {
  local panes states files updates scope target option value
  local -a args
  [ -n "$tmux_bin" ] || return 0

  panes=$("$tmux_bin" list-panes -a -F $'#{pane_id}\t#{session_id}\t#{session_name}\t#{window_id}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0

  states='[]'
  files=("$status_dir"/*.json)
  if [ -f "${files[0]}" ]; then
    states=$(jq -s '.' "${files[@]}" 2>/dev/null) || states='[]'
  fi

  updates=$(jq -rn --arg panes "$panes" --argjson states "$states" '
    def tmux_unread: if has("tmux_unread") then .tmux_unread else (.unread // false) end;
    def badge($symbol; $count):
      if $count == 0 then ""
      elif $count == 1 then " " + $symbol
      else " " + $symbol + ($count | tostring)
      end;
    def badges:
      badge("●"; map(select(.phase == "running")) | length)
      + badge("?"; map(select(.phase == "waiting")) | length)
      + badge("!"; map(select(.phase == "done" and tmux_unread)) | length);
    def escape_format: gsub("#"; "##");

    ($panes
      | split("\n")
      | map(
          split("\t")
          | select(length == 4)
          | {pane: .[0], session_id: .[1], session_name: .[2], window_id: .[3]}
        )
    ) as $layout
    | ($layout | map({key: .pane, value: .}) | from_entries) as $by_pane
    | [ $states[]
        | . as $state
        | ($by_pane[$state.pane // ""] // empty) as $seat
        | $state + {session_id: $seat.session_id, window_id: $seat.window_id}
      ] as $live
    | ($layout
        | group_by(.session_id)
        | map(.[0] as $head | {
            id: $head.session_id,
            name: $head.session_name,
            badges: ([$live[] | select(.session_id == $head.session_id)] | badges)
          })
        | sort_by(.name)
    ) as $sessions
    | [ $layout[]
        | .pane as $pane
        | ["pane", $pane, "@agent_status_pane",
           ([$live[] | select(.pane == $pane)] | badges)]
      ]
      + [ $layout | map(.window_id) | unique | .[] as $window
          | ["window", $window, "@agent_status_window",
             ([$live[] | select(.window_id == $window)] | badges)]
        ]
      + [ $sessions[]
          | ["session", .id, "@agent_status_session", .badges]
        ]
      + [ $sessions[]
          | . as $self
          | ["session", $self.id, "@agent_status_others",
             ([ $sessions[]
                | select(.id != $self.id and .badges != "")
                | "#[range=session|" + .id + "]" + (.name | escape_format) + .badges + "#[norange]"
              ] | if length == 0 then "" else join("  ") + "  " end)]
        ]
    | .[]
    | @tsv
  ' 2>/dev/null) || return 0
  [ -n "$updates" ] || return 0

  args=()
  while IFS=$'\t' read -r scope target option value; do
    [ -n "$scope" ] || continue
    [ ${#args[@]} -eq 0 ] || args+=(";")
    case "$scope" in
      pane) args+=(set-option -qp -t "$target" "$option" "$value") ;;
      window) args+=(set-option -qw -t "$target" "$option" "$value") ;;
      session) args+=(set-option -q -t "$target" "$option" "$value") ;;
    esac
  done <<<"$updates"

  [ ${#args[@]} -eq 0 ] || "$tmux_bin" "${args[@]}" 2>/dev/null || true
}

acknowledge_file() {
  local path="$1" temp nvim phase
  [ -f "$path" ] || return
  [ "$(jq -r '.unread // false' "$path")" = "true" ] || return
  nvim=$(jq -r '.nvim // empty' "$path")
  phase=$(jq -r '.phase // empty' "$path")
  if [ "$phase" = "done" ]; then
    rm -f "$path"
    notify_nvim "$path" "$nvim"
    return
  fi
  temp=$(mktemp "$status_dir/.state.XXXXXX")
  jq '.unread = false' "$path" >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$path"
  notify_nvim "$path" "$nvim"
}

acknowledge_tmux_file() {
  local path="$1" temp
  [ -f "$path" ] || return
  [ "$(jq -r '.phase == "done" and (if has("tmux_unread") then .tmux_unread else (.unread // false) end)' "$path")" = "true" ] || return

  temp=$(mktemp "$status_dir/.state.XXXXXX")
  jq '.tmux_unread = false' "$path" >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$path"
}

acknowledge_pane() {
  local pane="$1" file nvim
  for file in "$status_dir"/*.json; do
    [ -f "$file" ] || continue
    [ "$(jq -r '.pane // empty' "$file")" = "$pane" ] || continue
    nvim=$(jq -r '.nvim // empty' "$file")
    if [ -n "$nvim" ]; then
      acknowledge_tmux_file "$file"
    else
      acknowledge_file "$file"
    fi
  done
  refresh_tmux
}

acknowledge_path() {
  acknowledge_file "$1"
  refresh_tmux
}

remove_pane() {
  local pane="$1" file nvim
  for file in "$status_dir"/*.json; do
    [ -f "$file" ] || continue
    [ "$(jq -r '.pane // empty' "$file")" = "$pane" ] || continue
    nvim=$(jq -r '.nvim // empty' "$file")
    rm -f "$file"
    notify_nvim "$file" "$nvim"
  done
  refresh_tmux
}

case "${1:-}" in
  event)
    handle_event "${2:-agent}"
    ;;
  refresh)
    prune_stale_states
    refresh_tmux
    ;;
  acknowledge-path)
    acknowledge_path "${2:-}"
    ;;
  acknowledge-pane)
    acknowledge_pane "${2:-}"
    ;;
  remove-pane)
    remove_pane "${2:-}"
    ;;
  remove-path)
    remove_path "${2:-}"
    ;;
  prune)
    prune_stale_states
    ;;
  *)
    printf 'usage: agent-status {event|refresh|acknowledge-path|acknowledge-pane|remove-pane|remove-path|prune}\n' >&2
    exit 2
    ;;
esac
